types VVVTacticalBoardTypes
{
    type vvv_regiment_card = button {
        using = button_common_template
        size = { 112 80 }
        background = {
            texture = "[Select_CString(CombatSide.IsPlayerInCombat, 'gfx/interface/vvv/card_blue.dds', 'gfx/interface/vvv/card_red.dds')]"
        }
        background = {
            visible = "[EqualTo_string(SubUnit.GetKey, GetPlayer.MakeScope.GetVariable('vvv_selected_regiment').GetSubUnit.GetKey)]"
            texture = "gfx/interface/vvv/card_selected.dds"
        }
        enabled = "[GetScriptedGui('vvv_select_regiment').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('vvv_battle', Combat.MakeScope).AddScope('vvv_regiment', SubUnit.MakeScope).End)]"
        onclick = "[GetScriptedGui('vvv_select_regiment').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('vvv_battle', Combat.MakeScope).AddScope('vvv_regiment', SubUnit.MakeScope).End)]"
        tooltip = "[SubUnit.GetUITooltip]"
        tooltipwidget = { BasicFunctionalTooltip = {} }
        icon = {
            position = { 8 8 }
            size = { 26 26 }
            texture = "[SubUnit.GetTypeIcon]"
        }
        text_single = {
            position = { 37 8 }
            size = { 68 26 }
            autoresize = no
            align = center|nobaseline
            fontsize = 20
            text = "[SubUnit.GetStrength|0]"
        }
        text_single = {
            position = { 7 36 }
            size = { 98 18 }
            autoresize = no
            align = center|nobaseline
            fontsize = 12
            text = "[SubUnit.GetTypeName]"
        }
        progressbar = {
            position = { 10 59 }
            size = { 92 6 }
            using = progress_bar_green_red_alt
            value = "[SubUnit.GetMoralePercent]"
        }
        text_single = {
            position = { 7 65 }
            size = { 98 12 }
            autoresize = no
            align = center|nobaseline
            fontsize = 10
            text = "[SubUnit.GetMoralePercent|0%]"
        }
    }

    type vvv_side_roster = widget {
        size = { 752 206 }
        text_single = {
            position = { 0 0 }
            size = { 742 23 }
            autoresize = no
            fontsize = 15
            text = "[CombatSide.GetCountry.GetName] — [CombatSide.GetVisualStrength]"
        }
        scrollarea = {
            position = { 0 27 }
            size = { 752 179 }
            scrollbarpolicy_horizontal = always_off
            scrollwidget = {
                vbox = {
                    layoutpolicy_horizontal = expanding
                    spacing = 8
                    datamodel = "[CombatSide.GetUnits]"
                    item = {
                        vbox = {
                            layoutpolicy_horizontal = expanding
                            spacing = 3
                            text_single = {
                                size = { 720 18 }
                                autoresize = no
                                fontsize = 12
                                text = "[Unit.GetName]"
                            }
                            fixedgridbox = {
                                layoutpolicy_horizontal = expanding
                                addcolumn = 122
                                addcolumn = 122
                                addcolumn = 122
                                addcolumn = 122
                                addcolumn = 122
                                addcolumn = 122
                                addrow = 86
                                setitemsizefromcell = no
                                datamodel = "[Unit.GetSubUnits]"
                                item = { vvv_regiment_card = {} }
                            }
                        }
                    }
                }
            }
            scrollbar_vertical = { using = Scrollbar_Vertical }
        }
    }
    # Instantiated from a variable-list item so the typed combat context is
    # created when the handoff arrives, not cached while empty at game startup.
    type vvv_battle_content = widget {
        size = { 1104 704 }
        alwaystransparent = yes
        visible = "[And3(Combat.IsActive, GetVariableSystem.HasValue('vvv_open_battle', Combat.GetKey), Or(Combat.GetAttacker.IsPlayerInCombat, Combat.GetDefender.IsPlayerInCombat))]"

        text_single = {
            position = { 30 48 }
            size = { 950 24 }
            fontsize = 14
            autoresize = no
            text = "[Combat.GetName] · [Combat.GetLocation.GetTopography.GetName] · [Combat.GetLocation.GetVegetation.GetName]"
        }

        text_single = {
            position = { 34 99 }
            size = { 740 20 }
            autoresize = no
            fontsize = 12
            text = "VVV_ENEMY"
        }

        vvv_side_roster = {
            position = { 34 124 }
            visible = "[Combat.GetAttacker.IsPlayerInCombat]"
            datacontext = "[Combat.GetDefender]"
        }

        vvv_side_roster = {
            position = { 34 124 }
            visible = "[Not(Combat.GetAttacker.IsPlayerInCombat)]"
            datacontext = "[Combat.GetAttacker]"
        }

        text_single = {
            position = { 34 339 }
            size = { 740 20 }
            autoresize = no
            align = center|nobaseline
            fontsize = 12
            text = "VVV_FIELD_CAPTION"
        }

        text_single = {
            position = { 34 370 }
            size = { 740 20 }
            autoresize = no
            fontsize = 12
            text = "VVV_FRIENDLY"
        }

        vvv_side_roster = {
            position = { 34 394 }
            visible = "[Combat.GetAttacker.IsPlayerInCombat]"
            datacontext = "[Combat.GetAttacker]"
        }

        vvv_side_roster = {
            position = { 34 394 }
            visible = "[Not(Combat.GetAttacker.IsPlayerInCombat)]"
            datacontext = "[Combat.GetDefender]"
        }

        text_single = {
            position = { 832 99 }
            size = { 238 26 }
            autoresize = no
            fontsize = 18
            text = "VVV_COMMAND"
        }

        vbox = {
            position = { 832 142 }
            size = { 238 380 }
            spacing = 12
            visible = "[Not(GetScriptedGui('vvv_select_regiment').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('vvv_battle', Combat.MakeScope).AddScope('vvv_regiment', GetPlayer.MakeScope.GetVariable('vvv_selected_regiment')).End))]"
            text_multi = {
                layoutpolicy_horizontal = expanding
                autoresize = yes
                text = "VVV_SELECT_HINT"
            }
        }

        vbox = {
            position = { 832 142 }
            size = { 238 410 }
            spacing = 12
            visible = "[GetScriptedGui('vvv_select_regiment').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('vvv_battle', Combat.MakeScope).AddScope('vvv_regiment', GetPlayer.MakeScope.GetVariable('vvv_selected_regiment')).End)]"
            datacontext = "[GetPlayer.MakeScope.GetVariable('vvv_selected_regiment').GetSubUnit]"
            text_multi = {
                layoutpolicy_horizontal = expanding
                autoresize = yes
                fontsize = 18
                text = "[SubUnit.GetNameWithNoTooltip]"
            }
            text_single = {
                size = { 238 24 }
                autoresize = no
                text = "[SubUnit.GetStrength|0] · [SubUnit.GetMoralePercent|0%]"
            }
            button = {
                using = button_regular_texture
                using = button_common_template
                size = { 238 43 }
                text = "VVV_RALLY"
                enabled = "[GetScriptedGui('vvv_rally_regiment').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('vvv_battle', Combat.MakeScope).AddScope('vvv_regiment', SubUnit.MakeScope).End)]"
                onclick = "[GetScriptedGui('vvv_rally_regiment').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('vvv_battle', Combat.MakeScope).AddScope('vvv_regiment', SubUnit.MakeScope).End)]"
                tooltip = "VVV_RALLY_TT"
                tooltipwidget = { BasicFunctionalTooltip = {} }
            }
            text_multi = {
                layoutpolicy_horizontal = expanding
                autoresize = yes
                text = "VVV_RALLY_EFFECT"
            }
            text_multi = {
                visible = "[GetPlayer.MakeScope.GetVariableFromVariableMap('vvv_rally_cooldowns', SubUnit.MakeScope).IsSet]"
                layoutpolicy_horizontal = expanding
                autoresize = yes
                text = "VVV_RALLY_COOLDOWN"
            }
        }
    }
}

window = {
    name = "vvv_tactical_board"
    layer = top
    parentanchor = center
    widgetanchor = center
    size = { 1104 704 }
    movable = yes
    resizable = no
    allow_outside = yes
    filter_mouse = all
    # Opening the shell is client-only and never waits for a script result.
    visible = "[GetVariableSystem.Exists('vvv_open_battle')]"
    background = { texture = "gfx/interface/vvv/command_board.dds" }

    text_single = {
        position = { 28 14 }
        size = { 790 30 }
        fontsize = 23
        autoresize = no
        text = "VVV_BOARD_TITLE"
    }

    button = {
        using = button_regular_texture
        using = button_common_template
        position = { 1018 19 }
        size = { 60 31 }
        text = "VVV_CLOSE"
        onclick = "[GetVariableSystem.Clear('vvv_open_battle')]"
    }

    text_multi = {
        position = { 32 634 }
        size = { 1036 48 }
        autoresize = no
        fontsize = 13
        text = "VVV_ALPHA_SCOPE"
    }

    widget = {
        name = "vvv_live_battle_model"
        size = { 1104 704 }
        alwaystransparent = yes
        datamodel = "[GetPlayer.MakeScope.GetList('vvv_board_battles')]"
        item = {
            vvv_battle_content = { datacontext = "[Scope.GetCombat]" }
        }
    }

    widget = {
        name = "vvv_battle_handoff_status"
        position = { 40 150 }
        size = { 730 330 }
        visible = "[Not(And3(GetPlayer.MakeScope.GetVariable('vvv_current_battle').GetCombat.IsActive, GetVariableSystem.HasValue('vvv_open_battle', GetPlayer.MakeScope.GetVariable('vvv_current_battle').GetCombat.GetKey), Or(GetPlayer.MakeScope.GetVariable('vvv_current_battle').GetCombat.GetAttacker.IsPlayerInCombat, GetPlayer.MakeScope.GetVariable('vvv_current_battle').GetCombat.GetDefender.IsPlayerInCombat)))]"
        text_multi = {
            size = { 710 150 }
            autoresize = no
            fontsize = 18
            text = "VVV_WAITING_BATTLE"
        }
    }
}
